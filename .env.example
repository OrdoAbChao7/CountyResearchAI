# ===========================================
# CountyResearchAI V2 - 环境变量模板
# ===========================================
# 使用方法:
#   1. 复制本文件为 .env:  cp .env.example .env
#   2. 填入真实的 API Key（可留空，容器会使用 Mock 适配器）
#   3. .env 已被 .gitignore 忽略，不会提交到仓库
#
# 所有变量均可省略。缺少 LLM/搜索 Key 时平台仍可启动并跑通流程，
# 但结果会标记 degraded，不能作为研究证据。
# ===========================================

# ---------- LLM 大模型配置 ----------
# 供应商: openai / deepseek / qwen / 自定义 OpenAI 兼容端点
LLM_PROVIDER=deepseek
LLM_API_KEY=
# DeepSeek:  https://api.deepseek.com/v1
# Qwen:      https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI:    https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# ---------- 搜索 API 配置 ----------
# 搜索引擎: tavily / serper / bing
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
BING_API_KEY=
SEARCH_MAX_RESULTS=10
SEARCH_TIMEOUT=30
SEARCH_CONCURRENCY=3

# ---------- 知识图谱 ----------
# memory: 进程内实现（默认，无需外部服务）
# neo4j:  需安装可选依赖 pip install -e ".[graph]"
GRAPH_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---------- API ----------
API_HOST=127.0.0.1
API_PORT=8000
API_MAX_CONCURRENT_RUNS=2

# ---------- Agent 预算（覆盖 settings.yaml） ----------
AGENT_MAX_STEPS=6
AGENT_MAX_LLM_CALLS=6
AGENT_MAX_ROUNDS=2

# ---------- 存储与日志 ----------
# 留空使用项目默认路径 data/ 与 reports/
DATA_DIR=
REPORTS_DIR=
# 运行产物与检查点根目录（留空为 data/runs）
RUNS_DIR=
LOG_LEVEL=INFO
CACHE_TTL_HOURS=24
