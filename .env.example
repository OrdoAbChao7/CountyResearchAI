# ===========================================
# CountyResearchAI V2 - 环境变量模板
# ===========================================
# 使用方法:
#   1. 复制本文件为 .env:  cp .env.example .env
#   2. 填入真实的 API Key（可留空，容器会使用 Mock 适配器）
#   3. .env 已被 .gitignore 忽略，不会提交到仓库
#
# 所有变量均可省略。缺少 LLM/搜索 Key 时平台仍可启动并跑通流程，
# 但结果会标记 degraded，不能作为研究证据。
# ===========================================

# ---------- LLM 大模型配置 ----------
# 供应商: openai / deepseek / qwen / 自定义 OpenAI 兼容端点
LLM_PROVIDER=deepseek

# 通用兼容 API Key；若 LLM_PROVIDER=deepseek，可改用下方 DEEPSEEK_API_KEY
LLM_API_KEY=your-llm-api-key-here
# Provider-specific override. When LLM_PROVIDER=gemini, this takes precedence over LLM_API_KEY.
GEMINI_API_KEY=your-gemini-api-key-here

# DeepSeek 同一 Key 可供 LLM 与 Search/Fetch 使用（仅在确认账户计费边界后启用 Search/Fetch）
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# API Base URL(使用兼容端点时填写,留空则使用官方端点)
# DeepSeek:  https://api.deepseek.com/v1
# Qwen:      https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI:    https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# ---------- 搜索 API 配置 ----------
# 选择搜索引擎:tavily / serper / bing / deepseek
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
BING_API_KEY=

# DeepSeek Search/Fetch 默认关闭；只有确认该账户调用免费或已明确授权付费后才改为 true
DEEPSEEK_SEARCH_ENABLED=false

# 搜索参数
SEARCH_MAX_RESULTS=10
SEARCH_TIMEOUT=30
SEARCH_CONCURRENCY=3

# ---------- 知识图谱 ----------
# memory: 进程内实现（默认，无需外部服务）
# neo4j:  需安装可选依赖 pip install -e ".[graph]"
GRAPH_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---------- API ----------
API_HOST=127.0.0.1
API_PORT=8000
API_MAX_CONCURRENT_RUNS=2

# ---------- Agent 预算（覆盖 settings.yaml） ----------
AGENT_MAX_STEPS=6
AGENT_MAX_LLM_CALLS=6
AGENT_MAX_ROUNDS=2

# ---------- 存储与日志 ----------
# 留空使用项目默认路径 data/ 与 reports/
DATA_DIR=
REPORTS_DIR=

# ---------- 本地 API / 工作台 ----------
# 默认 false：即使 .env 有 Key，API 任务也强制走 MOCK，避免误触发付费调用。
# 只有在你明确允许真实 Provider 调用时，才改为 true。
AXIOMSCOPE_API_LIVE=false

# API 监听地址与端口
AXIOMSCOPE_API_HOST=127.0.0.1
AXIOMSCOPE_API_PORT=8000
AXIOMSCOPE_API_LOG_LEVEL=info

# 允许的前端来源（Vite 开发服务器）
AXIOMSCOPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

