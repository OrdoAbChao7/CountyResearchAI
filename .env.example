# ===========================================
# AI县域产业研究助手 - 环境变量模板
# ===========================================
# 使用方法:
#   1. 复制本文件为 .env:  cp .env.example .env
#   2. 填入真实的 API Key
#   3. .env 文件已被 .gitignore 忽略,不会提交到仓库
# ===========================================

# ---------- LLM 大模型配置 ----------
# 选择供应商:openai / deepseek / qwen / 自定义兼容端点
LLM_PROVIDER=deepseek

# API Key(必填)
LLM_API_KEY=YOUR_LLM_API_KEY

# API Base URL(使用兼容端点时填写,留空则使用官方端点)
# DeepSeek:  https://api.deepseek.com/v1
# Qwen:      https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI:    https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称
LLM_MODEL=deepseek-chat

# 生成参数
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# ---------- 搜索 API 配置 ----------
# 选择搜索引擎:tavily / serper / bing
SEARCH_PROVIDER=tavily

# Tavily(推荐,专为AI优化): https://tavily.com
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# Serper(基于Google): https://serper.dev
SERPER_API_KEY=

# Bing Search
BING_API_KEY=

# 搜索参数
SEARCH_MAX_RESULTS=10
SEARCH_TIMEOUT=30

# ---------- 应用配置 ----------
# 日志级别:DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 缓存有效期(小时),同一县+方向在此时间内复用数据
CACHE_TTL_HOURS=24

# 并发采集数
SEARCH_CONCURRENCY=3

# 数据/报告输出根目录(留空则使用项目默认路径)
DATA_DIR=
REPORTS_DIR=
